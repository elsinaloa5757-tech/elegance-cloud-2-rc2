ELEGANCE_ENV=production
ELEGANCE_SERVER_MODE=cloud
ELEGANCE_DATA_DIR=/data
ELEGANCE_ALLOWED_ORIGINS=https://panel.tudominio.com,https://catalogo.tudominio.com
ELEGANCE_PUBLIC_URL=https://panel.tudominio.com
PORT=8000
# Configure secretos exclusivamente en el panel del proveedor de despliegue.
# No agregue service_role, JWT secrets, contraseñas ni llaves privadas al repositorio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Bloque 4: almacenamiento de imágenes
# local = disco persistente; supabase = nube; mirror = ambas copias
ELEGANCE_STORAGE_MODE=mirror
SUPABASE_STORAGE_BUCKET=elegance-products
ELEGANCE_MAX_UPLOAD_MB=25

# Servidor propio Windows/Linux (sin mensualidad de VPS)
ELEGANCE_SERVER_MODE=home
ELEGANCE_ENABLE_BACKUP_SCHEDULER=1
ELEGANCE_DAILY_BACKUP_HOURS=24
ELEGANCE_WEEKLY_BACKUP_HOURS=168
ELEGANCE_BACKUP_CHECK_SECONDS=900
ELEGANCE_EXTERNAL_BACKUP_DIR=
ELEGANCE_TUNNEL_MODE=cloudflared
